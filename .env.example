# Local development only. Use strong, separate production credentials.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
LOG_LEVEL=info
POSTGRES_USER=pwint_thit
POSTGRES_PASSWORD=pwint_thit_dev
POSTGRES_DB=pwint_thit
POSTGRES_PORT=5432
DATABASE_URL=postgres://pwint_thit:pwint_thit_dev@127.0.0.1:5432/pwint_thit?sslmode=disable
# Used by the Vite server; browser requests remain same-origin.
API_PROXY_TARGET=http://127.0.0.1:8080
WEB_PORT=8088

# Exact browser origins for login/logout and all mutations. HTTPS required in production.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8088,http://localhost:8088
